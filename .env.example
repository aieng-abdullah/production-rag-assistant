# Copy to .env — fill in what you need. Never commit .env itself.

# --- LLM providers (at least one required; GROQ is the default) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b  # live alternatives: openai/gpt-oss-120b, openai/gpt-oss-20b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Voyage AI (embeddings + rerank; optional at boot — loud WARNING, no crash) ---
VOYAGE_API_KEY=

# --- Langfuse tracing (optional; absent -> tracing silently disabled) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- ChromaDB (empty = local file storage under data/chroma/) ---
CHROMA_HOST=
CHROMA_PORT=8000

# --- Relational DB (default: sqlite under data/) ---
# DATABASE_URL=sqlite:///data/app.db

# --- Auth (PLAN PR-2b) ---
# Google OAuth credentials (required for sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Enable auth gate (on/off). Default: on for real product.
APP_AUTH=on
# Public base URL of the app — Google OAuth redirect target is {APP_BASE_URL}/
# Local:  http://localhost:8501
# Cloud:  https://<your-app>.streamlit.app
APP_BASE_URL=http://localhost:8501

# --- API layer (restored FastAPI — PLAN-render-react Phase 3) ---
# HS256 signing key. Auto-generated in-memory when Google creds are absent
# (dev only — tokens die with the process). Set it for any shared deploy.
JWT_SECRET=
JWT_TTL_DAYS=7
# SPA origin: CORS allow_origins + OAuth fragment redirect {FRONTEND_URL}/auth#token=…
# Local Vite: http://localhost:5173 · Render Static Site: https://<site>.onrender.com
FRONTEND_URL=http://localhost:5173
# Google OAuth callback on the API — must be registered in Google Console.
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback
# Demo login: on | off | "" = auto (on exactly when no Google creds).
ENABLE_DEMO_LOGIN=
# API guest tier (ANON_* names pinned by src/services/quotas; same defaults
# as GUEST_QUERY_LIMIT, which serves the Streamlit session counter).
ANON_QUERY_LIMIT=3
ANON_DOCUMENT_LIMIT=1

# --- Quotas (PLAN PR-3b/PR-4b/PR-6; free-tier defaults shown) ---
# DAILY_QUERY_LIMIT counts usage units; verified answers cost 2 units each.
DAILY_QUERY_LIMIT=20
DOCUMENT_LIMIT=5
STORAGE_LIMIT_MB=100
# Guest tier: free try-out before the login wall.
GUEST_QUERY_LIMIT=3

# --- Stripe billing (PLAN PR-5) — routes register only when keys present ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE=

# --- Logging ---
LOG_LEVEL=INFO