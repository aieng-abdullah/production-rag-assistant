# Copy to .env — fill in what you need. Never commit .env itself.

# --- LLM providers (at least one required; GROQ is the default) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b  # live alternatives: openai/gpt-oss-120b, openai/gpt-oss-20b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Google OAuth + JWT (optional; absent -> /auth/* returns 501) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501/auth/google/callback
JWT_SECRET=
JWT_TTL_DAYS=7
FRONTEND_URL=http://localhost:8501

# --- Langfuse tracing (optional; absent -> tracing silently disabled) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- ChromaDB (empty = local file storage under data/chroma/) ---
CHROMA_HOST=
CHROMA_PORT=8000

# --- Relational DB (default: sqlite under data/) ---
# DATABASE_URL=sqlite:///data/app.db

# --- Quotas (PLAN PR-3b/PR-4b; free-tier defaults shown) ---
# DAILY_QUERY_LIMIT counts usage units; verified answers cost 2 units each.
DAILY_QUERY_LIMIT=20
DOCUMENT_LIMIT=5
STORAGE_LIMIT_MB=100

# --- Logging ---
LOG_LEVEL=INFO
